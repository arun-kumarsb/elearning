# ==============================================================================
# Xen-Based Dynamic Resource Allocation for Scalable E-Learning Services
# Environment Configuration Template (.env.example)
#
# IMPORTANT: All IP addresses and VM names must be configured dynamically.
# Never hardcode old IP addresses or VM names in application source code.
# ==============================================================================

# Flask Backend API Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=xen-elearning-secret-key-2026-secure

# MariaDB Database VM Configuration (Alpine-DB VM)
DB_HOST=10.189.191.248
DB_PORT=3306
DB_NAME=elearning
DB_USER=elearning
DB_PASSWORD=elearning123

# Streamlit Frontend Configuration
BACKEND_API_URL=http://10.189.191.51:5000/api
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Xen / XCP-ng Hypervisor Infrastructure Metadata & XAPI
XCP_NG_HOST=10.189.191.175
XCP_NG_USERNAME=root
XCP_NG_PASSWORD=your_xcp_password_here
XCP_NG_VERIFY_SSL=false

# VM Discovery & Monitoring Targets (Actual Xen VM name_label)
APP_VM_NAME=Alpine-Linux
DB_VM_NAME=Alpine-DB
APP_VM_IP=10.189.191.51
DB_VM_IP=10.189.191.248
XEN_ENVIRONMENT=XCP-ng Virtualized Infrastructure

# Monitoring & Elasticity Engine Configuration (Phase 3 Parameters)
MONITOR_INTERVAL=5
ALLOCATION_MODE=manual
COOLDOWN_PERIOD=60
CONSECUTIVE_BREACH_THRESHOLD=2

# CPU Allocation Limits & Thresholds
CPU_SCALE_UP_THRESHOLD=80
CPU_SCALE_DOWN_THRESHOLD=25
MIN_VCPUS=1
MAX_VCPUS=4

# RAM Dynamic Allocation (Ballooning) Limits & Thresholds
RAM_SCALE_UP_THRESHOLD=85
RAM_SCALE_DOWN_THRESHOLD=30
RAM_INCREMENT_MB=512
RAM_MIN_MB=1024
RAM_MAX_MB=4096

USE_MOCK_DB=False
